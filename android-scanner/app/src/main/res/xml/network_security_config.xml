<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Hardening: Disallow Cleartext Traffic Entirely -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pinned domains for Google OAuth & Apps Script -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">script.google.com</domain>
        <domain includeSubdomains="true">script.googleusercontent.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
    </domain-config>
</network-security-config>
